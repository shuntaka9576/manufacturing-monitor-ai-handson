{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "uv run python .claude/scripts/statusline.py",
    "padding": 0
  }
}
